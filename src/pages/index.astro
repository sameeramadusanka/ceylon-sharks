---
import TeamDashboard from '../components/TeamDashboard';
import '../styles/global.css';
import team from '../data/team.json';
import site from '../data/site.json';
import { readdirSync, readFileSync } from 'node:fs';
import { basename, join } from 'node:path';

const publicDirectory = join(process.cwd(), 'public');
const basePath = import.meta.env.BASE_URL;
const publicAsset = (path: string) => `${basePath.replace(/\/$/, '')}/${path.replace(/^\/+/, '')}`;
const filesIn = (directory: string): string[] => (readdirSync(directory, { withFileTypes: true }) as import('node:fs').Dirent[]).flatMap((entry) => {
  const path = join(directory, entry.name);
  return entry.isDirectory() ? filesIn(path) : [path];
});
const playersBySeason = Object.fromEntries(
  filesIn(join(publicDirectory, 'players'))
    .map((filePath) => ({ filePath, fileName: basename(filePath) }))
    .filter(({ fileName }) => /__PLAYERS__\d{4}\.json$/.test(fileName))
    .map(({ filePath, fileName }) => {
      const legacyMatch = fileName.match(/^(.+)__(.+)__PLAYERS__(\d{4})\.json$/);
      const modernMatch = fileName.match(/^(.+)__PLAYERS__(\d{4})\.json$/);
      const match = legacyMatch ?? modernMatch;
      if (!match) return null;
      const season = match[1];
      return [season, readFileSync(filePath, 'utf8')];
    })
    .filter((entry): entry is [string, string] => entry !== null),
);
const optimizedBannerDirectory = join(publicDirectory, 'banner_images', 'optimized');
const bannerImages = (readdirSync(optimizedBannerDirectory) as string[])
  .filter((fileName) => /\.(avif|gif|jpe?g|png|webp)$/i.test(fileName))
  .sort()
  .map((fileName) => publicAsset(`/banner_images/optimized/${fileName}`));
const groundImage = (readdirSync(join(publicDirectory, 'ground_images')) as string[])
  .filter((fileName) => /\.(avif|gif|jpe?g|png|webp)$/i.test(fileName))
  .sort()
  .map((fileName) => publicAsset(`/ground_images/${fileName}`))[0] ?? '';
const playerImages = Object.fromEntries(
  (readdirSync(join(publicDirectory, 'player_images')) as string[])
    .filter((fileName) => /^(\d+)\.(avif|gif|jpe?g|png|webp)$/i.test(fileName))
    .map((fileName) => [fileName.replace(/\.[^.]+$/, ''), publicAsset(`/player_images/${fileName}`)]),
);
const seasonResultsDirectory = join(publicDirectory, 'season_results');
const scoreCardsDirectory = join(publicDirectory, 'score_cards');
const seasonFiles = filesIn(seasonResultsDirectory)
  .map((filePath) => ({ filePath, fileName: basename(filePath) }))
  .filter(({ fileName }) => /__RESULTS__\d{4}\.json$/.test(fileName))
  .map(({ filePath, fileName }) => {
    const legacyMatch = fileName.match(/^(.+)__(.+)__RESULTS__(\d{4})\.json$/);
    const modernMatch = fileName.match(/^(.+)__RESULTS__(\d{4})\.json$/);
    const match = legacyMatch ?? modernMatch;
    if (!match) throw new Error(`Invalid season results filename: ${fileName}`);
    const [, season, division, year] = match.length >= 4 ? match : [match[0], match[1], match[1], match[2]];
    return { fileName, season, division: division ?? season, year: Number(year), content: readFileSync(filePath, 'utf8') };
  });
const seasonStatisticsDirectory = join(publicDirectory, 'season_statistics');
const seasonStatistics = filesIn(seasonStatisticsDirectory)
  .map((filePath) => ({ filePath, fileName: basename(filePath) }))
  .filter(({ fileName }) => /__([A-Z]+)__\d{4}\.json$/.test(fileName))
  .map(({ filePath, fileName }) => {
    const legacyMatch = fileName.match(/^(.+)__(.+)__([A-Z]+)__(\d{4})\.json$/);
    const modernMatch = fileName.match(/^(.+)__([A-Z]+)__(\d{4})\.json$/);
    const match = legacyMatch ?? modernMatch;
    if (!match) throw new Error(`Invalid season statistics filename: ${fileName}`);

    if (legacyMatch) {
      const [, season, division, statisticsType] = match;
      return { fileName, season, division, statisticsType, content: readFileSync(filePath, 'utf8') };
    }

    const [, season, statisticsType] = match;
    return { fileName, season, division: season, statisticsType, content: readFileSync(filePath, 'utf8') };
  });
const scoreCards = filesIn(scoreCardsDirectory)
  .map((filePath) => ({ filePath, fileName: basename(filePath) }))
  .filter(({ fileName }) => /__MATCH-\d+__\d{4}-\d{2}-\d{2}\.json$/.test(fileName))
  .map(({ filePath, fileName }) => {
    const legacyMatch = fileName.match(/^(.+)__(.+)__MATCH-(\d+)__(\d{4}-\d{2}-\d{2})\.json$/);
    const modernMatch = fileName.match(/^(.+)__MATCH-(\d+)__(\d{4}-\d{2}-\d{2})\.json$/);
    const match = legacyMatch ?? modernMatch;
    if (!match) throw new Error(`Invalid scorecard filename: ${fileName}`);
    const [, season, division, matchNumber, date] = match.length >= 5 ? match : [match[0], match[1], match[1], match[2], match[3]];
    return { fileName, season, division: division ?? season, matchNumber: Number(matchNumber), date, content: readFileSync(filePath, 'utf8') };
  });
const upcomingScheduleMatches = filesIn(join(publicDirectory, 'upcoming_schedules'))
  .map((filePath) => ({ filePath, fileName: basename(filePath) }))
  .filter(({ fileName }) => /\.json$/.test(fileName))
  .flatMap(({ filePath, fileName }) => {
    try {
      const parsed = JSON.parse(readFileSync(filePath, 'utf8')) as { matches?: Array<Record<string, unknown>> };
      return (parsed.matches ?? []).map((match) => ({
        fileName,
        date: String(match.date ?? ''),
        time: String(match.time ?? ''),
        teamOne: String(match.teamOne ?? match.homeTeam ?? ''),
        teamTwo: String(match.teamTwo ?? match.awayTeam ?? ''),
        ground: String(match.ground ?? match.venue ?? ''),
        status: String(match.status ?? 'Scheduled'),
        result: match.result == null ? null : typeof match.result === 'string' ? match.result : JSON.stringify(match.result),
      }));
    } catch {
      return [];
    }
  });

const title = `${team.name} | ${site.seo.titleSuffix}`;
const description = site.seo.descriptionTemplate.replace('{team}', team.name);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#111314" />
    <link rel="canonical" href={site.seo.canonicalUrl} />
    <title>{title}</title>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-B35J5LJTFY"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        window.dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-B35J5LJTFY');
    </script>
  </head>
  <body>
    <TeamDashboard client:load playersBySeason={playersBySeason} bannerImages={bannerImages} groundImage={groundImage} playerImages={playerImages} seasonFiles={seasonFiles} seasonStatistics={seasonStatistics} scoreCards={scoreCards} upcomingScheduleMatches={upcomingScheduleMatches} />
  </body>
</html>
