{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudFormationStack",
      "Effect": "Allow",
      "Action": "cloudformation:*",
      "Resource": "arn:aws:cloudformation:ap-southeast-1:037207781401:stack/ceylon-sharks-availability/*"
    },
    {
      "Sid": "CloudFormationValidate",
      "Effect": "Allow",
      "Action": "cloudformation:ValidateTemplate",
      "Resource": "*"
    },
    {
      "Sid": "SamDeploymentBucket",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:s3:::aws-sam-cli-managed-default*",
        "arn:aws:s3:::aws-sam-cli-managed-default*/*"
      ]
    },
    {
      "Sid": "LambdaFunctions",
      "Effect": "Allow",
      "Action": "lambda:*",
      "Resource": "arn:aws:lambda:ap-southeast-1:037207781401:function:ceylon-sharks-availability-*"
    },
    {
      "Sid": "DynamoDbTables",
      "Effect": "Allow",
      "Action": "dynamodb:*",
      "Resource": [
        "arn:aws:dynamodb:ap-southeast-1:037207781401:table/ceylon-sharks-availability-*",
        "arn:aws:dynamodb:ap-southeast-1:037207781401:table/ceylon-sharks-availability-*/index/*"
      ]
    },
    {
      "Sid": "LogGroups",
      "Effect": "Allow",
      "Action": "logs:*",
      "Resource": "arn:aws:logs:ap-southeast-1:037207781401:log-group:/aws/lambda/ceylon-sharks-availability-*"
    },
    {
      "Sid": "EventBridgeSchedule",
      "Effect": "Allow",
      "Action": "scheduler:*",
      "Resource": "arn:aws:scheduler:ap-southeast-1:037207781401:schedule/default/CoordinatorFunctionDailySchedule"
    },
    {
      "Sid": "IamRolesForStackFunctions",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:GetRole",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:GetRolePolicy",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies"
      ],
      "Resource": "arn:aws:iam::037207781401:role/ceylon-sharks-availabilit*"
    },
    {
      "Sid": "IamPassRoleScopedByService",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::037207781401:role/ceylon-sharks-availabilit*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": [
            "lambda.amazonaws.com",
            "scheduler.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "ApiGatewayV2",
      "Effect": "Allow",
      "Action": "apigateway:*",
      "Resource": "arn:aws:apigateway:ap-southeast-1::/apis*"
    },
    {
      "Sid": "CloudFormationSamTransform",
      "Effect": "Allow",
      "Action": "cloudformation:CreateChangeSet",
      "Resource": "arn:aws:cloudformation:ap-southeast-1:aws:transform/Serverless-2016-10-31"
    }
  ]
}